# Supabase (Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Publora (publicação de conteúdo)
# Docs: https://docs.publora.com
# Autenticação: Header 'x-publora-key'
PUBLORA_API_KEY=pk_your-publora-key-here
PUBLORA_BASE_URL=https://api.publora.com

# Zernio (inbox e automação de atendimento)
# Docs: https://docs.zernio.com
# Autenticação: Bearer token no header Authorization
ZERNIO_API_KEY=sk_your-zernio-api-key-here
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Meta/Instagram Graph API (fallback para comentários, se Zernio não cobrir)
# Docs: https://developers.facebook.com/docs/instagram-api
# Autenticação: Access token com permissões instagram_business_manage_comments
META_ACCESS_TOKEN=your-meta-access-token-here
META_API_VERSION=v18.0

# Claude API (geração de conteúdo e resposta automática)
# Docs: https://platform.openai.com/docs/api-reference (substitua por Anthropic quando aplicável)
CLAUDE_API_KEY=your-claude-api-key-here

# CRM (integração de leads)
# Docs: sua documentação local
CRM_API_URL=http://localhost:3001
CRM_API_KEY=your-crm-api-key-here

# Telegram (notificações de handoff)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Marca (white-label)
NEXT_PUBLIC_BRAND_NAME=Social Central
NEXT_PUBLIC_BRAND_TAGLINE=Conteúdo e atendimento do Instagram, num lugar só

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
